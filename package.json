{
  "name": "commerce-accessibility-lab",
  "version": "0.2.0",
  "private": true,
  "description": "Reproducible accessibility, technical SEO and agent-readability audits for commerce pages.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "bin": { "commerce-audit": "bin/commerce-audit.mjs" },
  "scripts": {
    "audit": "node bin/commerce-audit.mjs audit",
    "study": "node bin/commerce-audit.mjs study",
    "microtests": "node bin/commerce-audit.mjs microtests",
    "practices": "node bin/commerce-audit.mjs practices",
    "gate": "node bin/commerce-audit.mjs gate",
    "react:verify": "node scripts/verify-react-practices.mjs",
    "lint:a11y": "eslint examples/react-storefront --max-warnings 0",
    "typecheck": "tsc -p examples/react-storefront/tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node --test test/browser/*.test.mjs",
    "check": "node --check bin/commerce-audit.mjs && node --test test/*.test.mjs",
    "browsers": "playwright install chromium"
  },
  "dependencies": {
    "axe-core": "4.10.3",
    "cheerio": "1.2.0",
    "playwright": "1.62.1",
    "robots-parser": "3.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.72.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3"
  }
}
